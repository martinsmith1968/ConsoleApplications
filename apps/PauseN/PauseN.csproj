<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <ApplicationIcon>assets\pause-button-red-icon.ico</ApplicationIcon>
    <Title>Pause batch execution with a timeout</Title>
    <Copyright>Copyright © 2004-{Now:yyyy} Martin Smith</Copyright>
    <Authors>MartinSmith1968</Authors>
    <Company>Martin Smith</Company>
    <Description>A simple app to pause batch execution with a timeout</Description>
    <AssemblyVersion>0.1.0.*</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DNX.Extensions" Version="2.26326.2461" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageReference Include="DNX.Helpers" Version="2.1.0" />
    <PackageReference Include="Ookii.CommandLine" Version="5.0.0" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="assets\pause-button-red-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\ConsoleApplications.Common\ConsoleApplications.Common.csproj" />
  </ItemGroup>

</Project>
