<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationIcon>assets\special-folders.ico</ApplicationIcon>
    <Title>Draw a calendar in the console</Title>
    <Copyright>Copyright © 2004-{Now:yyyy} Martin Smith</Copyright>
    <Authors>MartinSmith1968</Authors>
    <Company>Martin Smith</Company>
    <Description>A simple app to draw a calendar in the console</Description>
    <AssemblyVersion>0.1.0.*</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="assets\special-folders.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DNX.Extensions" Version="1.4.25131.2031" />
    <PackageReference Include="Ookii.CommandLine" Version="5.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.51.1" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.51.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\ConsoleApplications.Common\ConsoleApplications.Common.csproj" />
  </ItemGroup>

</Project>
